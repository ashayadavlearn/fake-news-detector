# Copy this file to .env and fill in real values before deploying.
# app.py reads these via os.environ; python-dotenv is installed if you want
# to auto-load .env locally (add `from dotenv import load_dotenv; load_dotenv()`
# to the very top of app.py if you use one).

FLASK_ENV=production
SECRET_KEY=change-this-to-a-long-random-string
DATABASE_URL=sqlite:///fake_news.db
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-strong-password
ADMIN_EMAIL=admin@yourdomain.com
PORT=5000
